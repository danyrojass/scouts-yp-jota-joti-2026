// Exploracion de Ypacarai - Prisma schema
// PostgreSQL data model for the orienteering QR race.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev (Windows/Linux/macOS), rhel-openssl-3.0.x for the
  // Amazon Linux runtime used by Vercel when running `prisma migrate deploy`.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum EventStatus {
  PREPARED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum ChallengeType {
  CODE
  QUESTION
  CONFIRMATION
  AUTO
}

enum VisitStatus {
  VALID
  INCORRECT
}

// Estado de evaluacion de una actividad del ranking general.
enum ActivityStatus {
  PENDING
  IN_EVALUATION
  FINISHED
}

// Como se otorgan los puntos de una actividad. Durante el MVP todo es MANUAL;
// CHECKLIST y STATIONS quedan preparados para reglas automaticas futuras
// (p. ej. el Safari o las postas QR) sin sobrescribir resultados manuales.
enum ScoringMethod {
  MANUAL
  CHECKLIST
  STATIONS
}

// Administrative users.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model Event {
  id          String      @id @default(cuid())
  name        String
  description String?
  date        DateTime
  location    String?
  status      EventStatus @default(PREPARED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Publicacion del ranking general. Mientras es false la vista publica
  // muestra "clasificacion no disponible". Se registra cuando se publica.
  rankingPublished   Boolean   @default(false)
  rankingPublishedAt DateTime?

  teams    Team[]
  stations Station[]
  visits   StationVisit[]
  auditLogs AuditLog[]
  safari   Safari?
  safariFinds SafariFind[]
  activities        Activity[]
  teamActivityScores TeamActivityScore[]

  @@index([status])
}

model Team {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  username     String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  routeStops RouteStop[]
  visits     StationVisit[]
  safariFinds SafariFind[]
  auditLogs  AuditLog[]
  activityScores TeamActivityScore[]

  @@index([eventId])
  @@unique([eventId, name])
}

model Station {
  id             String        @id @default(cuid())
  eventId        String
  name           String
  description    String?
  publicToken    String        @unique
  challengeType  ChallengeType
  instructions   String?
  displayedCode  String?
  expectedAnswer String?
  autoAcceptAny  Boolean       @default(false)
  active         Boolean       @default(true)
  // Optional geographic position, loaded by an admin (form or CSV). NULL means
  // the station has no coordinates yet and cannot be drawn on the map.
  latitude       Float?
  longitude      Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  routeStops RouteStop[]
  visits     StationVisit[]

  @@index([eventId])
  @@unique([eventId, name])
}

// A station position inside a team's itinerary.
model RouteStop {
  id        String @id @default(cuid())
  teamId    String
  stationId String
  position  Int
  // Optional per-team "bonus question": when set, THIS team answers it at this
  // stop instead of the station's default challenge. Lets each team get its own
  // randomly assigned question even at a shared physical station.
  // questionAnswer is a "|"-separated list of accepted answers; NULL = any
  // non-empty answer is accepted.
  question       String?
  questionAnswer String?

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([teamId, position])
  @@unique([teamId, stationId])
  @@index([teamId])
}

model StationVisit {
  id              String      @id @default(cuid())
  eventId         String
  teamId          String
  stationId       String
  visitedAt       DateTime    @default(now())
  submittedAnswer String?
  isCorrect       Boolean?
  status          VisitStatus
  attemptNumber   Int         @default(1)
  // Set only when the visit is VALID: "<teamId>:<stationId>". Postgres allows
  // multiple NULLs in a unique column, so this enforces at most one VALID
  // visit per team+station while allowing unlimited incorrect attempts.
  validKey        String?     @unique

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([teamId, stationId])
  @@index([eventId])
  @@index([visitedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  actorType String
  actorId   String?
  userId    String?
  teamId    String?
  eventId   String?
  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  team  Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// Safari de Exploracion: a per-event checklist the teams complete together. It
// is fully independent from the QR-station itinerary and progress.
model Safari {
  id          String   @id @default(cuid())
  eventId     String   @unique
  title       String   @default("Safari de Exploración")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items SafariItem[]
  finds SafariFind[]

  @@index([eventId])
}

model SafariItem {
  id            String   @id @default(cuid())
  safariId      String
  name          String
  description   String?
  position      Int      @default(0)
  active        Boolean  @default(true)
  category      String   @default("GENERAL")
  itemType      String   @default("PHOTO")
  requiresPhoto Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  safari Safari      @relation(fields: [safariId], references: [id], onDelete: Cascade)
  finds  SafariFind[]

  @@index([safariId])
}

// A single "found" mark. The unique pair guarantees at most one find per item
// and team, so concurrent marks cannot duplicate.
model SafariFind {
  id         String   @id @default(cuid())
  safariId   String
  itemId     String
  teamId     String
  eventId    String
  value      String?
  photoReady Boolean  @default(false)
  foundAt    DateTime @default(now())

  safari Safari     @relation(fields: [safariId], references: [id], onDelete: Cascade)
  item   SafariItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  team   Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event  Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([itemId, teamId])
  @@index([teamId])
  @@index([safariId])
  @@index([eventId])
}

// Una actividad puntuable del ranking general (Safari, caminata, talleres...).
// Configurable desde el panel admin salvo por su eventId; no comparte resultados
// entre eventos distintos.
model Activity {
  id          String         @id @default(cuid())
  eventId     String
  name        String
  description String?
  // Puntaje maximo opcional. Si es NULL la actividad no tiene tope.
  maxScore    Float?
  position    Int            @default(0)
  status      ActivityStatus @default(PENDING)
  scoringMethod ScoringMethod @default(MANUAL)
  // Si los resultados de esta actividad estan publicados en la vista publica.
  published   Boolean        @default(false)
  // Permiso explicito para cargar un puntaje mayor al maximo configurado.
  allowMaxScoreExceeded Boolean @default(false)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event  Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scores TeamActivityScore[]

  @@index([eventId])
  @@unique([eventId, name])
}

// Resultado vigente de un equipo en una actividad. `evaluated=false` significa
// "sin evaluar" (NO es lo mismo que cero puntos): en ese caso `score` es NULL.
// El par unico (teamId, activityId) garantiza un unico resultado vigente.
model TeamActivityScore {
  id           String    @id @default(cuid())
  eventId      String
  teamId       String
  activityId   String
  score        Float?
  evaluated    Boolean   @default(false)
  observations String?
  evaluatedBy  String?
  evaluatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([teamId, activityId])
  @@index([eventId])
  @@index([activityId])
}
