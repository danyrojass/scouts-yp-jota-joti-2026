# ---------------------------------------------------------------------------
# Exploracion de Ypacarai - variables de entorno para Vercel (produccion).
#
# Como usarlo:
#   1. Reemplaza los valores <...> por los reales.
#   2. NO lo subas al repo: contiene secretos. Esto es solo una plantilla.
#   3. Cargalo en Vercel:
#        - Dashboard: Project -> Settings -> Environment Variables -> "Paste .env"
#          (pega el contenido) y elegi el entorno Production.
#        - O por CLI, una por una:  vercel env add <NAME> production
#   4. Podes borrar las lineas opcionales (tienen default en el codigo).
#   5. Despues de cargarlas, hacé un Redeploy (los cambios de env no aplican solos).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
# PORT no se define en Vercel: lo administra la plataforma.

# URL publica del sitio (se usa para construir los enlaces/QR)
PUBLIC_BASE_URL=https://<tu-proyecto>.vercel.app
# Origenes permitidos por CORS. SPA + API en el mismo dominio = un solo valor.
CORS_ORIGINS=https://<tu-proyecto>.vercel.app
# Saltos de proxy confiables. En Vercel es 1 (un numero, no "true").
TRUST_PROXY=1

# Base de datos: cadena POOLED (el host contiene "-pooler") con sslmode=require.
# Vercel Postgres suele crear las variables POSTGRES_*; si no crea DATABASE_URL,
# copiá el valor de POSTGRES_PRISMA_URL (pooled) en DATABASE_URL.
DATABASE_URL=postgresql://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Sesiones
# SESSION_SECRET debe tener 32+ caracteres en produccion.
SESSION_SECRET=<48-chars-aleatorios>
SESSION_COOKIE_NAME=ypacarai.sid
SESSION_TTL_HOURS=24
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Limite de intentos de login
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Administrador inicial (lo usa `npm run create-admin`, no el login)
ADMIN_USERNAME=<tu-admin>
ADMIN_PASSWORD=<clave-fuerte>
