# ---------------------------------------------------------------------------
# Exploracion de Ypacarai - environment template.
# Copy to server/.env for local development, or define these in the Vercel
# dashboard (Project -> Settings -> Environment Variables) when deploying.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Public origin used to build QR links. On Vercel: https://<project>.vercel.app
PUBLIC_BASE_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS. A same-domain SPA + API
# deployment can keep a single value. On Vercel: https://<project>.vercel.app
CORS_ORIGINS=http://localhost:5173
# Number of trusted proxy hops. 0 = local dev; 1 on Vercel.
TRUST_PROXY=0

# Database. Local Docker maps Postgres to 5433.
# On Vercel use a POOLED connection string (Neon/Supabase), e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://ypacarai:ypacarai@127.0.0.1:5433/ypacarai?schema=public

# Sessions
# Must be >= 32 chars in production.
SESSION_SECRET=change-me-with-a-long-random-string
SESSION_COOKIE_NAME=ypacarai.sid
SESSION_TTL_HOURS=24
# true in production (HTTPS only). On Vercel: true
COOKIE_SECURE=false
# lax | strict | none. Same-domain SPA + API can keep "lax".
COOKIE_SAMESITE=lax

# Login rate limiting
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Bootstrap admin (used by the create-admin script / initial seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
